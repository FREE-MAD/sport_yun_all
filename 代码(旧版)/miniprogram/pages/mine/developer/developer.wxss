.container { padding: 20rpx; }
.header { font-size: 36rpx; font-weight: bold; margin-bottom: 30rpx; }
.section { margin-bottom: 40rpx; border: 1px solid #eee; padding: 20rpx; border-radius: 10rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
.form-group .input { border: 1px solid #ddd; padding: 20rpx; margin-bottom: 20rpx; border-radius: 5rpx; }
.btn-primary { background-color: #07c160; color: white; margin-top: 10rpx; margin-bottom: 10rpx; }
.btn-secondary { background-color: #f0f0f0; color: #333; margin-top: 10rpx; margin-bottom: 10rpx; }
.btn-small { font-size: 24rpx; padding: 5rpx 10rpx; background-color: #07c160; color: white; display: inline-block; }

/* Tab Bar Styles */
.tab-bar { display: flex; border-bottom: 1px solid #eee; margin-bottom: 20rpx; }
.tab-item { flex: 1; text-align: center; padding: 15rpx 0; font-size: 28rpx; color: #666; }
.tab-item.active { color: #07c160; border-bottom: 2px solid #07c160; font-weight: bold; }

/* Order List Styles */
.order-list { margin-top: 20rpx; }
.order-item { border-bottom: 1px solid #eee; padding: 15rpx 0; display: flex; justify-content: space-between; align-items: center; }
.order-item:active { background-color: #f5f5f5; }
.order-info { font-size: 24rpx; color: #666; flex: 1; }
.order-info view { margin-bottom: 5rpx; }
.copy-text { color: #576b95; text-decoration: underline; }

/* Log List Styles */
.log-list { margin-top: 20rpx; }
.log-item { border-bottom: 1px solid #eee; padding: 15rpx 0; font-size: 24rpx; }
.log-time { color: #999; margin-bottom: 5rpx; }
.log-level { display: inline-block; padding: 2rpx 8rpx; border-radius: 4rpx; font-weight: bold; margin-right: 10rpx; font-size: 20rpx; }
.log-level.error { background-color: #ffeaea; color: #fa5151; }
.log-level.info { background-color: #e6f7ff; color: #1890ff; }
.log-msg { color: #333; margin-bottom: 5rpx; word-break: break-all; }
.log-details { color: #666; background: #f9f9f9; padding: 10rpx; border-radius: 5rpx; margin-top: 5rpx; }
.no-data { text-align: center; color: #999; padding: 30rpx; }

/* Login Styles */
.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #f8f8f8;
}

.login-box {
  background: white;
  padding: 40rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  width: 80%;
  max-width: 600rpx;
}

.login-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.login-input {
  border: 1px solid #ddd;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}