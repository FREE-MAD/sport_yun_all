.page {
  background: #f8f8f8;
  height: 100vh;
}

.title {
  padding: 30rpx 40rpx;
  font-size: 36rpx;
  font-weight: 600;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.list {
  /* height: calc(100vh - 100rpx); Remove fixed height to allow page scroll */
  padding-bottom: 30rpx;
}

.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* 每条聊天 */
.item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.item:active {
  background: #f0f0f0;
}

/* 头像 */
.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 16rpx;
  margin-right: 26rpx;
}

/* 名称 + 消息 */
.content {
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.msg {
  font-size: 26rpx;
  color: #888;
}

/* 时间 */
.time {
  font-size: 24rpx;
  color: #aaa;
}
