
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
  position: relative;
  z-index: 10;
}

.header-left text, .header-right text {
  font-size: 40rpx;
  color: #333;
  padding: 0 20rpx;
}

.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 5rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  text-align: center;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.user-status {
  font-size: 22rpx;
  color: #999;
}

.chat-messages {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
  overflow-y: scroll; 
}

.time-divider {
  text-align: center;
  margin: 20rpx 0;
}

.time-text {
  font-size: 22rpx;
  color: #999;
  background-color: rgba(0,0,0,0.05);
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-item.sent {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #ddd;
  margin: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  flex-shrink: 0;
}

.message-content {
  max-width: 60%;
  display: flex;
  flex-direction: column;
}

.message-item.sent .message-content {
  align-items: flex-end;
}

.sender-name {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.message-bubble {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
}

.message-item.sent .message-bubble {
  background-color: #95ec69; 
}

.chat-input-bar {
  background-color: #f7f7f7;
  padding: 20rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #e5e5e5;
}

.input-left text, .input-right button {
  margin: 0 10rpx;
}

.input-left text {
  font-size: 48rpx;
  color: #666;
}

.input-center {
  flex: 1;
  margin: 0 20rpx;
}

.input-center input {
  background-color: #fff;
  height: 70rpx;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.input-right button {
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 10rpx;
}

/* Negotiation Form Styles */
.form-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  box-sizing: border-box;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx;
}

.form-content {
  flex: 1;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-tips {
  margin-top: 40rpx;
  padding: 20rpx;
  background-color: #fffbe6;
  border-radius: 10rpx;
  color: #faad14;
  font-size: 24rpx;
  line-height: 1.5;
}

.form-footer {
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  font-weight: bold;
}
