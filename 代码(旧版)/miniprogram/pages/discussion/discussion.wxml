<view class="page">

<!-- 顶部区域 -->
<view class="header">
  <view class="header-text">
    <view class="title">运动社区</view>

<!-- 发布帖子模态框 -->
<view class="modal-mask" wx:if="{{showPublishModal}}" bindtap="hidePublishModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">发布新帖子</text>
      <view class="modal-close" bindtap="hidePublishModal">×</view>
    </view>
    
    <view class="modal-body">
      <view class="form-group">
        <input class="form-input" 
               placeholder="请输入标题" 
               value="{{newPost.title}}"
               bindinput="onPostTitleInput" />
      </view>
      
      <view class="form-group">
        <textarea class="form-textarea" 
                  placeholder="分享你的运动生活..." 
                  value="{{newPost.content}}"
                  bindinput="onPostContentInput" />
      </view>
      
      <view class="form-group">
        <input class="form-input" 
               placeholder="标签（可选）" 
               value="{{newPost.tag}}"
               bindinput="onPostTagInput" />
      </view>
      
      <view class="form-group">
        <view class="image-upload">
          <view class="upload-btn" bindtap="chooseImage" wx:if="{{newPost.images.length < 3}}">
            <image class="upload-icon" src="/images/add.png"></image>
            <text class="upload-text">添加图片</text>
          </view>
          
          <view class="image-list">
            <view class="image-item" wx:for="{{newPost.images}}" wx:key="*this">
              <image class="image" src="{{item}}" mode="aspectFill"></image>
              <view class="image-delete" bindtap="deleteImage" data-index="{{index}}">×</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="btn-cancel" bindtap="hidePublishModal">取消</button>
  <button class="btn-submit" bindtap="submitPost">发布</button>
    </view>
  </view>
</view>
</view>

