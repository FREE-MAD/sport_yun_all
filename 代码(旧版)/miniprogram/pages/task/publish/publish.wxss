/* 全局重置与变量 */
page {
  --primary-color: #1976d2;
  --primary-light: #e3f2fd;
  --text-main: #333333;
  --text-sub: #666666;
  --text-placeholder: #bbbbbb;
  --bg-color: #f7f8fa;
  --card-bg: #ffffff;
  --border-color: #eeeeee;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);

  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
}

.status-bar-placeholder {
  width: 100%;
  background-color: #fff;
  flex-shrink: 0;
}

/* Tab 导航 */
.tabs-header {
  display: flex;
  background-color: #fff;
  height: 96rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
  z-index: 100;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-sub);
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
  font-size: 32rpx;
}

.tab-indicator {
  width: 40rpx;
  height: 6rpx;
  background: transparent;
  border-radius: 4rpx;
  margin-top: 8rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-indicator {
  background: var(--primary-color);
}

/* 主滚动区 */
.main-scroll {
  flex: 1;
  background-color: var(--bg-color);
  height: 0; /* 必须设置，配合 flex:1 生效 */
  width: 100%;
}

/* Banner */
.banner-box {
  padding: 24rpx 32rpx;
}

.banner-content {
  background: linear-gradient(135deg, #e3f2fd, #f0f7ff);
  color: #1565c0;
  font-size: 26rpx;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(25, 118, 210, 0.1);
}

/* 内容淡入动画 */
.fade-in {
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 附近列表 */
.content-section {
  padding: 0 32rpx;
}

.nearby-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: var(--shadow-sm);
}

.nearby-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #eee;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.nearby-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nearby-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.nearby-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.nearby-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.nearby-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.nearby-footer {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.nearby-dist {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  font-size: 28rpx;
  color: #999;
}

/* 横向滚动 - 课程选择 */
.section-header {
  margin: 40rpx 0 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 横向滚动区域 */
.class-scroll-view {
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: row;
  /* align-items: stretch; 默认即为stretch，移除 flex-start 以实现高度统一 */
  white-space: nowrap;
  padding-top: 10rpx; /* 增加顶部空间防止上浮被遮挡 */
  padding-bottom: 30rpx; /* 增加底部空间防止阴影被遮挡 */
  box-sizing: border-box;
}

/* 单个卡片 */
.class-card {
  flex-shrink: 0;
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-left: 32rpx; /* 左侧间距 */
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  border: 2rpx solid transparent;
  overflow: hidden; /* 保持圆角 */
  position: relative;
  white-space: normal; /* 恢复正常换行 */
  vertical-align: top;
}

.class-card.active {
  border-color: #1976d2;
  background-color: #f0f7ff;
  box-shadow: 0 8rpx 24rpx rgba(25, 118, 210, 0.15);
  /* 移除 transform，避免超出父容器可视区域 */
  /* transform: translateY(-2rpx); */
}

/* 卡片主体 */
.class-card-main {
  padding: 24rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.class-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #42a5f5, #1976d2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 44rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.class-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.class-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.class-desc {
  font-size: 26rpx;
  color: #888;
  white-space: normal;
  line-height: 1.4;
}

.class-check {
  margin-left: 16rpx;
}

/* 操作条 */
.class-action-bar {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(0,0,0,0.05);
  font-size: 26rpx;
  color: #1976d2;
  background-color: rgba(25, 118, 210, 0.02);
  transition: background-color 0.2s;
}

.class-action-bar:active {
  background-color: rgba(25, 118, 210, 0.08);
}

.action-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  transition: transform 0.3s;
  display: inline-block;
}

.action-arrow.expanded {
  transform: rotate(180deg);
}

/* 子选项区域 */
.class-sub-area {
  padding: 24rpx;
  background-color: #fff;
  border-top: 1rpx solid rgba(0,0,0,0.03);
  animation: slideDown 0.3s ease-out;
}

.sub-tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sub-tag {
  padding: 12rpx 28rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  transition: all 0.2s;
  border: 1rpx solid transparent;
}

.sub-tag.selected {
  background-color: #e3f2fd;
  color: #1565c0;
  border-color: rgba(25, 118, 210, 0.3);
  font-weight: 500;
}

.scroll-spacer {
  width: 32rpx;
  flex-shrink: 0;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 课程详情卡片 */
.course-detail-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-sm);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.detail-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 24rpx;
  text-align: justify;
}

.detail-imgs {
  white-space: nowrap;
  height: 160rpx;
}

.detail-img {
  width: 240rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background-color: #eee;
}

/* 表单样式 */
.form-container {
  padding-bottom: 40rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 16rpx;
  font-weight: 600;
  display: block;
}

.form-label.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 6rpx;
}

.form-input-box, .form-input {
  width: 100%;
  min-height: 96rpx;
  background: #fff;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--text-main);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s;
}

.form-input-box {
  height: auto;
  padding: 24rpx;
  line-height: 1.4;
}

.form-input {
  height: 96rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #fff;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 1.5;
}

.form-input:focus, .form-textarea:focus, .form-input-box:active {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx rgba(25, 118, 210, 0.1);
}

.input-placeholder {
  color: var(--text-placeholder);
}

.input-val {
  color: var(--text-main);
}

.switch-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
}

.switch-label {
  display: flex;
  flex-direction: column;
}

.switch-label .main-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.switch-label .main-text.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 6rpx;
}

.switch-label .sub-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.submit-wrapper {
  margin-top: 60rpx;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1976d2, #1565c0);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 10rpx 20rpx rgba(21, 101, 192, 0.3);
  border: none;
}

.btn-submit:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.footer-spacer {
  height: 100rpx;
}

/* Loading Mask */
.loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.9);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--primary-light);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
