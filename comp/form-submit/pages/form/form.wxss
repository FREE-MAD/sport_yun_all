/* 业务积木：表单提交 - 样式（多类型版，业务方可按需覆盖） */

.form-block {
  padding: 32rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ee0a24;
  margin-left: 4rpx;
}

/* 文本/数字输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 多行文本 */
.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 日期/下拉选择：模拟 input 外观 */
.form-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 选择框未选时的占位文字颜色 */
.form-picker-placeholder {
  color: #c0c4cc;
}

/* 单选/多选按钮组 */
.form-radio-group {
  display: flex;
  flex-wrap: wrap;
  padding-top: 12rpx;
}

.form-radio-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.form-radio-label {
  margin-left: 8rpx;
}

/* 提交按钮 */
.form-submit-btn {
  margin-top: 40rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}
